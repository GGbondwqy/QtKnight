digraph flow {
  graph [label="3.10 到达出口、完成目标并进入下一关", labelloc=t, fontsize=18, fontname="Microsoft YaHei", rankdir=TB, bgcolor="#FFFFFF", pad=0.25, nodesep=0.35, ranksep=0.55, splines=polyline, dpi=140];
  node [fontname="Microsoft YaHei", fontsize=11, margin="0.15,0.09", penwidth=1.2, color="#64748B"];
  edge [fontname="Microsoft YaHei", fontsize=9, color="#64748B", fontcolor="#334155", arrowsize=0.7];
  "G1" [label="业务层：\n本帧已有世界快照和碰撞裁决", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "M" [label="地图与碰撞：\nqueryTriggers()", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G2" [label="业务层：\n目标和开门条件满足？", shape=diamond, style="filled", fillcolor="#FEF3C7"];
  "E" [label="业务层：\n排入出口锁定提示", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "S1" [label="对象与状态：\napplyChanges(本关完成变更)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G3" [label="业务层：\nmakeSaveData()", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "E2" [label="业务层：\n保持原世界并提示失败", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "V" [label="存档与数据库：\nwriteSlot(进度)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G4" [label="业务层：\n显示关卡完成并等待下一关命令", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "U" [label="界面：\n点击下一关", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "G5" [label="业务层：\nsubmitCommand(下一关)", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "C" [label="关卡与配置：\nloadLevel(下一关编号)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G6" [label="业务层：\n接收定义", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "F" [label="业务层：\n释放已有候选、保留旧关卡并提示重试", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "S2" [label="对象与状态：\ncreateWorld()", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G7" [label="业务层：\n检查创建结果", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "S3" [label="对象与状态：\ninitializeWorld(候选世界, 下一关, \n进度副本)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G8" [label="业务层：\n保留候选世界", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "M2" [label="地图与碰撞：\ncreateMap(下一关)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G9" [label="业务层：\n一次切换关卡并释放旧句柄", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "G10" [label="业务层：\nmakeRenderSnapshot()、\npublishEvents()", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "U2" [label="界面：\nreadRenderSnapshot() 绘制下一关", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "G1" -> "M";
  "M" -> "G2" [label="出口命中"];
  "G2" -> "E" [label="否"];
  "G2" -> "S1" [label="是"];
  "S1" -> "G3" [label="已提交进度"];
  "S1" -> "E2" [label="提交失败"];
  "G3" -> "V";
  "V" -> "G4" [label="保存结果"];
  "G4" -> "U";
  "U" -> "G5";
  "G5" -> "C";
  "C" -> "G6" [label="已验证关卡"];
  "C" -> "F" [label="失败"];
  "G6" -> "S2";
  "S2" -> "G7" [label="候选世界句柄"];
  "S2" -> "F" [label="空指针"];
  "G7" -> "S3";
  "S3" -> "G8" [label="初始化成功"];
  "S3" -> "F" [label="失败"];
  "G8" -> "M2";
  "M2" -> "G9" [label="候选索引"];
  "M2" -> "F" [label="失败"];
  "G9" -> "G10";
  "G10" -> "U2";
}
