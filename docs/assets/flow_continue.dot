digraph flow {
  graph [label="3.3 点击“继续游戏”并选择存档", labelloc=t, fontsize=18, fontname="Microsoft YaHei", rankdir=TB, bgcolor="#FFFFFF", pad=0.25, nodesep=0.35, ranksep=0.55, splines=polyline, dpi=140];
  node [fontname="Microsoft YaHei", fontsize=11, margin="0.15,0.09", penwidth=1.2, color="#64748B"];
  edge [fontname="Microsoft YaHei", fontsize=9, color="#64748B", fontcolor="#334155", arrowsize=0.7];
  "U" [label="界面：\n选择存档槽位", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "G1" [label="业务层：\nsubmitCommand(继续游戏, 槽位号)", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "S" [label="存档与数据库：\nreadSlot(槽位号)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G2" [label="业务层：\n读取关卡编号", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "E" [label="业务层：\n释放已有候选、留在主菜单并显示错误", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "C" [label="关卡与配置：\nloadLevel(关卡编号)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G3" [label="业务层：\n校验检查点引用", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "W1" [label="对象与状态：\ncreateWorld()", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G4" [label="业务层：\n检查创建结果", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "W2" [label="对象与状态：\ninitializeWorld(候选世界, 关卡, S\naveData)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G5" [label="业务层：\n保留候选世界", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "M" [label="地图与碰撞：\ncreateMap(关卡)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G6" [label="业务层：\n切换为游玩中", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "G7" [label="业务层：\nmakeRenderSnapshot()、\npublishEvents()", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "U2" [label="界面：\nreadRenderSnapshot() 显示恢复后的\n关卡", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "U" -> "G1";
  "G1" -> "S";
  "S" -> "G2" [label="SaveData"];
  "S" -> "E" [label="槽位不存在、损坏或版本错误"];
  "G2" -> "C";
  "C" -> "G3" [label="已验证关卡"];
  "C" -> "E" [label="失败"];
  "G3" -> "W1";
  "W1" -> "G4" [label="候选世界句柄"];
  "W1" -> "E" [label="空指针"];
  "G4" -> "W2";
  "W2" -> "G5" [label="初始化成功"];
  "W2" -> "E" [label="失败"];
  "G5" -> "M";
  "M" -> "G6" [label="候选索引"];
  "M" -> "E" [label="失败"];
  "G6" -> "G7";
  "G7" -> "U2";
}
