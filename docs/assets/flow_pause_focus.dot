digraph flow {
  graph [label="3.11 暂停、继续与窗口失焦", labelloc=t, fontsize=18, fontname="Microsoft YaHei", rankdir=TB, bgcolor="#FFFFFF", pad=0.25, nodesep=0.35, ranksep=0.55, splines=polyline, dpi=140];
  node [fontname="Microsoft YaHei", fontsize=11, margin="0.15,0.09", penwidth=1.2, color="#64748B"];
  edge [fontname="Microsoft YaHei", fontsize=9, color="#64748B", fontcolor="#334155", arrowsize=0.7];
  "U1" [label="界面：\n按暂停键", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "G1" [label="业务层：\nsubmitCommand(暂停)", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "G2" [label="业务层：\nhandleMenuCommand() 将会话改为已暂\n停", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "G3" [label="业务层：\nadvanceElapsed() 不推进世界", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "U2" [label="界面：\nreadRenderSnapshot() 显示暂停菜单", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "U3" [label="界面：\n窗口失焦", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "G4" [label="业务层：\nsubmitCommand(所有按住动作释放)", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "G5" [label="业务层：\nnormalizeCommand() 清空按住状态", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "U4" [label="界面：\n点击继续", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "G6" [label="业务层：\nsubmitCommand(继续)", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "G7" [label="业务层：\nhandleMenuCommand() 恢复游玩并重置\n计时基准", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "U5" [label="界面：\n下一次定时唤醒再调用 advanceElapsed()", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "U1" -> "G1";
  "G1" -> "G2";
  "G2" -> "G3";
  "G3" -> "U2";
  "U3" -> "G4";
  "G4" -> "G5";
  "U4" -> "G6";
  "G6" -> "G7";
  "G7" -> "U5";
}
