digraph flow {
  graph [label="3.13 保存并返回菜单、退出程序", labelloc=t, fontsize=18, fontname="Microsoft YaHei", rankdir=TB, bgcolor="#FFFFFF", pad=0.25, nodesep=0.35, ranksep=0.55, splines=polyline, dpi=140];
  node [fontname="Microsoft YaHei", fontsize=11, margin="0.15,0.09", penwidth=1.2, color="#64748B"];
  edge [fontname="Microsoft YaHei", fontsize=9, color="#64748B", fontcolor="#334155", arrowsize=0.7];
  "U" [label="界面：\n选择保存并返回", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "G1" [label="业务层：\nsubmitCommand(保存并返回)", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "S1" [label="对象与状态：\nreadWorld()", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G2" [label="业务层：\nmakeSaveData()", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "V" [label="存档与数据库：\nwriteSlot(存档副本)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G3" [label="业务层：\n排入保存成功事件", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "G4" [label="业务层：\n排入尚未保存事件", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "G5" [label="业务层：\n切到主菜单并准备释放本关句柄", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "U2" [label="界面：\ntakeEvents() 显示保存失败，\n保留当前会话供重试", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "S2" [label="对象与状态：\ndestroyWorld()", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G6" [label="业务层：\n继续清理本关", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "M" [label="地图与碰撞：\ndestroyMap()", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G7" [label="业务层：\n生成主菜单快照", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "U4" [label="界面：\nreadRenderSnapshot()、\ntakeEvents()", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "U3" [label="界面：\n从主菜单退出程序", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "G8" [label="业务层：\ndestroyGame()", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "V2" [label="存档与数据库：\ncloseSaveStore()", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "U" -> "G1";
  "G1" -> "S1";
  "S1" -> "G2" [label="已提交世界快照"];
  "G2" -> "V";
  "V" -> "G3" [label="成功"];
  "V" -> "G4" [label="失败"];
  "G3" -> "G5";
  "G4" -> "U2";
  "G5" -> "S2";
  "S2" -> "G6" [label="释放完成"];
  "G6" -> "M";
  "M" -> "G7" [label="释放完成"];
  "G7" -> "U4";
  "U3" -> "G8";
  "G8" -> "V2";
}
