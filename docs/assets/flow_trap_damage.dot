digraph flow {
  graph [label="3.8 碰到陷阱、受伤和死亡", labelloc=t, fontsize=18, fontname="Microsoft YaHei", rankdir=TB, bgcolor="#FFFFFF", pad=0.25, nodesep=0.35, ranksep=0.55, splines=polyline, dpi=140];
  node [fontname="Microsoft YaHei", fontsize=11, margin="0.15,0.09", penwidth=1.2, color="#64748B"];
  edge [fontname="Microsoft YaHei", fontsize=9, color="#64748B", fontcolor="#334155", arrowsize=0.7];
  "G1" [label="业务层：\n已完成本帧运动碰撞裁决", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "M" [label="地图与碰撞：\nqueryTriggers(地图, 快照, 裁决)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G2" [label="业务层：\n组装陷阱输入", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "C1" [label="战斗与陷阱：\nevaluateTraps(输入, 命中)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G3" [label="业务层：\n合并本帧战斗候选", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "C2" [label="战斗与陷阱：\nresolveDamage(旧快照, 候选)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G4" [label="业务层：\n取消死亡者的交互候选", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "S" [label="对象与状态：\napplyChanges(整批变更)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G5" [label="业务层：\n玩家生命是否为零？", shape=diamond, style="filled", fillcolor="#FEF3C7"];
  "D" [label="业务层：\n会话进入死亡中", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "P" [label="业务层：\n继续游玩", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "U" [label="界面：\nreadRenderSnapshot()、\ntakeEvents()", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "G1" -> "M";
  "M" -> "G2" [label="危险区命中 TriggerBatch"];
  "G2" -> "C1";
  "C1" -> "G3" [label="陷阱伤害候选"];
  "G3" -> "C2";
  "C2" -> "G4" [label="扣血、击退或死亡候选"];
  "G4" -> "S";
  "S" -> "G5" [label="提交后生命和事件"];
  "G5" -> "D" [label="是"];
  "G5" -> "P" [label="否"];
  "D" -> "U";
  "P" -> "U";
}
