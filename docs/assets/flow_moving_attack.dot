digraph flow {
  graph [label="3.6 按住移动键时按 J 攻击，以及再次攻击", labelloc=t, fontsize=18, fontname="Microsoft YaHei", rankdir=TB, bgcolor="#FFFFFF", pad=0.25, nodesep=0.35, ranksep=0.55, splines=polyline, dpi=140];
  node [fontname="Microsoft YaHei", fontsize=11, margin="0.15,0.09", penwidth=1.2, color="#64748B"];
  edge [fontname="Microsoft YaHei", fontsize=9, color="#64748B", fontcolor="#334155", arrowsize=0.7];
  "U1" [label="界面：\n移动键保持按住", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "G1" [label="业务层：\n保存移动按住状态", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "U2" [label="界面：\nJ 新按下", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "G2" [label="业务层：\nsubmitCommand(攻击按下)", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "G3" [label="业务层：\nadvanceElapsed() 合并移动与攻击", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "S1" [label="对象与状态：\nreadWorld()", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G4" [label="业务层：\n新攻击请求是否合法？", shape=diamond, style="filled", fillcolor="#FEF3C7"];
  "G5" [label="业务层：\n标记本帧新攻击并保留移动意图", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "E" [label="业务层：\n不新增攻击实例，保留移动意图", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "P" [label="运动与物理：\nproposeMotion(快照, 关卡, 意图, 步长)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G6" [label="业务层：\n接收运动提案", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "M" [label="地图与碰撞：\nresolveMovement(地图, 快照, 提案)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G7" [label="业务层：\n接收裁决", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "P2" [label="运动与物理：\nfinishMotion(提案, 裁决)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G8" [label="业务层：\n组装含修正站位的 CombatInput", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "C1" [label="战斗与陷阱：\nevaluateAttacks(攻击输入)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G9" [label="业务层：\n合并本帧已计算的陷阱候选", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "C2" [label="战斗与陷阱：\nresolveDamage(旧快照, 候选)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G10" [label="业务层：\n合并运动和战斗变更", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "S2" [label="对象与状态：\napplyChanges(整批变更)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G11" [label="业务层：\n编号并发布事件", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "U3" [label="界面：\nreadRenderSnapshot()、\ntakeEvents()", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "U4" [label="界面：\nJ 释放后再次按下且冷却结束时，重新从本图入口执行", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "U1" -> "G1";
  "U2" -> "G2";
  "G1" -> "G3";
  "G2" -> "G3";
  "G3" -> "S1";
  "S1" -> "G4" [label="生命、冷却、速度和攻击状态"];
  "G4" -> "G5" [label="是"];
  "G4" -> "E" [label="否"];
  "G5" -> "P";
  "E" -> "P";
  "P" -> "G6" [label="运动提案 MotionBatch"];
  "G6" -> "M";
  "M" -> "G7" [label="碰撞裁决 CollisionBatch"];
  "G7" -> "P2";
  "P2" -> "G8" [label="位置和速度候选"];
  "G8" -> "C1";
  "C1" -> "G9" [label="攻击阶段与命中候选"];
  "G9" -> "C2";
  "C2" -> "G10" [label="生命、击退与事件候选"];
  "G10" -> "S2";
  "S2" -> "G11" [label="提交后快照"];
  "G11" -> "U3";
  "U3" -> "U4";
}
