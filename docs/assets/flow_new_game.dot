digraph flow {
  graph [label="3.2 鼠标点击“开始游戏”", labelloc=t, fontsize=18, fontname="Microsoft YaHei", rankdir=TB, bgcolor="#FFFFFF", pad=0.25, nodesep=0.35, ranksep=0.55, splines=polyline, dpi=140];
  node [fontname="Microsoft YaHei", fontsize=11, margin="0.15,0.09", penwidth=1.2, color="#64748B"];
  edge [fontname="Microsoft YaHei", fontsize=9, color="#64748B", fontcolor="#334155", arrowsize=0.7];
  "U" [label="界面：\n点击开始", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "G1" [label="业务层：\nsubmitCommand(新游戏)", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "G2" [label="业务层：\nhandleMenuCommand 检查主菜单状态", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "C" [label="关卡与配置：\nloadLevel(首关编号)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G3" [label="业务层：\n接收关卡定义", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "E" [label="业务层：\n释放已有候选、保留主菜单并排入错误事件", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "S1" [label="对象与状态：\ncreateWorld()", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G4" [label="业务层：\n检查创建结果", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "S2" [label="对象与状态：\ninitializeWorld(候选世界, 关卡, 空\n恢复数据)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G5" [label="业务层：\n保留候选世界", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "M" [label="地图与碰撞：\ncreateMap(关卡)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G6" [label="业务层：\n接收地图句柄", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "V" [label="存档与数据库：\ncreateSlot(初始进度)", shape=box, style="rounded,filled", fillcolor="#EDE9FE"];
  "G7" [label="业务层：\n切换为游玩中", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "G8" [label="业务层：\nmakeRenderSnapshot()、\npublishEvents()", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  "U2" [label="界面：\nreadRenderSnapshot() 显示首关", shape=box, style="rounded,filled", fillcolor="#DBEAFE"];
  "U" -> "G1";
  "G1" -> "G2";
  "G2" -> "C";
  "C" -> "G3" [label="已验证关卡"];
  "C" -> "E" [label="失败"];
  "G3" -> "S1";
  "S1" -> "G4" [label="候选世界句柄"];
  "S1" -> "E" [label="空指针"];
  "G4" -> "S2";
  "S2" -> "G5" [label="初始化成功"];
  "S2" -> "E" [label="失败"];
  "G5" -> "M";
  "M" -> "G6" [label="候选地图索引"];
  "M" -> "E" [label="失败"];
  "G6" -> "V";
  "V" -> "G7" [label="新槽位编号"];
  "V" -> "E" [label="失败"];
  "G7" -> "G8";
  "G8" -> "U2";
}
